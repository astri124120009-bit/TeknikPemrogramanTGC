# Membuat class induk bernama Sensor
class Sensor:
    def __init__(self, id_sensor, lokasi, jenis):
        self.id_sensor = id_sensor
        self.lokasi = lokasi
        self.jenis = jenis
    def info(self):
        print("Informasi Sensor:")
        print(f"ID Sensor   : {self.id_sensor}")
        print(f"Lokasi      : {self.lokasi}")
        print(f"Jenis       : {self.jenis}")
class SensorSeismik(Sensor):
    def __init__(self, id_sensor, lokasi, jenis, frekuensi_sampling):
        super().__init__(id_sensor, lokasi, jenis)
        self.frekuensi_sampling = frekuensi_sampling  # dalam Hz
    def jumlah_sampel(self, durasi_detik):
        """
        Menghitung jumlah data amplitudo yang dikumpulkan dalam durasi tertentu.
        Formula: frekuensi_sampling * durasi
        """
        return self.frekuensi_sampling * durasi_detik
if __name__ == "__main__":
    sensor_seismik = SensorSeismik("S001", "Yogyakarta", "Seismik", 100)
    sensor_seismik.info()
    print(f"Frekuensi Sampling : {sensor_seismik.frekuensi_sampling} Hz")
    durasi = 10  # dalam detik
    jumlah = sensor_seismik.jumlah_sampel(durasi)
    print(f"Jumlah Sampel dalam {durasi} detik : {jumlah} sampel")


