# Membuat class abstrak
class Survey(ABC):
    abstractmethod
    def processing(self):
        pass
# Class turunan untuk Seismic Survey
class SeismicSurvey(Survey):
    def processing(self):
        print("Memproses data seismik: Filtering sinyal dan stacking gelombang.")
# Class turunan untuk Gravity Survey
class GravitySurvey(Survey):
    def processing(self):
        print("Memproses data gravitasi: Upward continuation dan koreksi Bouguer.")
# Class turunan untuk Magnetik Survey
class MagnetikSurvey(Survey):
    def processing(self):
        print("Memproses data magnetik: Pemetaan anomali dan reduksi ke kutub.")
# Membuat objek-objek survey
seismic = SeismicSurvey()
gravity = GravitySurvey()
magnetik = MagnetikSurvey()
# Memasukkan objek ke dalam list
daftar_survey = [seismic, gravity, magnetik]
# Iterasi dan memanggil method processing untuk setiap objek
for survey in daftar_survey:
    survey.processing()
